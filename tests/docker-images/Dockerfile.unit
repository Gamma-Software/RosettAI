# syntax=docker/dockerfile:1

FROM rust:1-bookworm

RUN apt-get update \
    && apt-get install --yes --no-install-recommends git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Unit tests query the Codex version but do not invoke the Codex CLI.
RUN printf '#!/bin/sh\nif [ "$1" = "--version" ]; then\n  printf "codex-cli 0.158.0\\n"\nelse\n  exit 1\nfi\n' \
      > /usr/local/bin/codex \
    && chmod 755 /usr/local/bin/codex

WORKDIR /workspace
COPY . .
RUN cargo test --locked --no-run --bin rai

CMD ["cargo", "test", "--locked", "--bin", "rai"]
