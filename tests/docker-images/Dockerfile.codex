# syntax=docker/dockerfile:1

FROM rust:1-bookworm AS rai-builder

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN cargo build --locked --release

FROM node:22-bookworm-slim

ARG CODEX_VERSION=0.158.0
ARG COPILOT_VERSION=1.0.89

LABEL org.opencontainers.image.title="RosettAI harness test image"
LABEL org.opencontainers.image.description="Codex CLI, GitHub Copilot CLI, and VS Code with GitHub Copilot"

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        curl \
        git \
        gnupg \
        ripgrep \
        x11vnc \
        xvfb \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global "@openai/codex@${CODEX_VERSION}" \
        "@github/copilot@${COPILOT_VERSION}" \
    && npm cache clean --force

RUN curl --fail --silent --show-error https://packages.microsoft.com/keys/microsoft.asc \
        | gpg --dearmor -o /usr/share/keyrings/microsoft.gpg \
    && printf 'Types: deb\nURIs: https://packages.microsoft.com/repos/code\nSuites: stable\nComponents: main\nArchitectures: amd64 arm64\nSigned-By: /usr/share/keyrings/microsoft.gpg\n' \
        > /etc/apt/sources.list.d/vscode.sources \
    && apt-get update \
    && apt-get install --yes --no-install-recommends code \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /workspace /home/node/.codex /home/node/.copilot \
        /home/node/.config/Code /home/node/.vscode/extensions /tmp/.X11-unix \
    && chmod 1777 /tmp/.X11-unix \
    && chown -R node:node /workspace /home/node/.codex /home/node/.copilot \
        /home/node/.config/Code /home/node/.vscode

COPY --from=rai-builder /build/target/release/rai /usr/local/bin/rai
COPY --chmod=755 tests/docker-images/codex-smoke.sh /usr/local/bin/codex-smoke
COPY --chmod=755 tests/docker-images/copilot-smoke.sh /usr/local/bin/copilot-smoke
COPY --chmod=755 tests/docker-images/copilot-desktop.sh /usr/local/bin/copilot-desktop

USER node
RUN node -e "const p = require('/usr/share/code/resources/app/extensions/copilot/package.json'); if (p.publisher !== 'GitHub' || p.name !== 'copilot-chat') process.exit(1)"
ENV COPILOT_AUTO_UPDATE=false
WORKDIR /workspace

EXPOSE 5900

CMD ["codex-smoke"]
